iv><div class="row"><span class="muted">0% complete</span><button class="icon">Edit</button></div></div><div class="goal"><div class="goal-top"><strong>Long-term investment</strong><span class="muted">R0 / R10&nbsp;000</span></div><div class="progress"><i style="width:0%;background:linear-gradient(90deg,var(--green),var(--purple))"></i></div><div class="row"><span class="muted">0% complete</span><button class="icon">Edit</button></div></div></div></div></div></section>

